library(ggplot2)
ggplot(data_movsho, aes(x = genre, y = count, fill = type)) +
geom_col(position = "dodge") +
facet_wrap(~ country) +
labs(
title = "Most Common Genres by Country and Type",
x = "Genre",
y = "Count"
) +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
